# ==================================================
# CLAUSENT - Environment Configuration (.env.example)
# ==================================================

APP_NAME=CLAUSENT
APP_ENV=development
DEBUG=True

# Server Bindings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# CORS Allowed Origins (Comma-separated)
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Connection
# PostgreSQL Connection (Default local installation: user postgres, port 5432)
DATABASE_URL=postgresql://postgres:1234@localhost:5432/clausent_db
# Or SQLite fallback:
# DATABASE_URL=sqlite:///./clausent.db


# File Storage
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt

# Hugging Face Model Cache
MODEL_CACHE_DIR=./data/models

# NLP Models Configuration
LEGAL_BERT_MODEL=nlpaueb/legal-bert-base-uncased
ENABLE_LEGAL_BERT=True

# SLM (Small Language Model for routine explanations)
# Options: mock_local (fast heuristic baseline), hf_local (HuggingFace transformers), api (external)
SLM_PROVIDER=mock_local
SLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
SLM_DEVICE=cpu

# LLM (Large Language Model for detailed high-risk analysis)
# Options: mock_local (built-in analysis engine), gemini, openai, ollama
LLM_PROVIDER=mock_local
LLM_MODEL_NAME=gemini-2.5-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Translation Configuration
# Languages: English, Tamil, Hindi, Malayalam, Telugu
TRANSLATION_PROVIDER=indic_nllb
DEFAULT_TARGET_LANGUAGE=English
