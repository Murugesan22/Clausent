# ==================================================
# CLAUSENT - AI-Powered Multilingual Contract Risk Analyzer
# Root Environment Configuration Template (.env.example)
# ==================================================

APP_NAME=CLAUSENT
APP_ENV=development
DEBUG=True

# Server Bindings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# Frontend Development Origin
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Database Configuration
# PostgreSQL (Default local installation: user postgres, port 5432)
DATABASE_URL=postgresql://postgres:1234@localhost:5432/clausent_db
# Or SQLite fallback:
# DATABASE_URL=sqlite:///./clausent.db

# File Storage Limits & Directories
UPLOAD_DIR=./data/uploads
REPORT_DIR=./data/reports
MAX_UPLOAD_SIZE_MB=25
ALLOWED_EXTENSIONS=pdf,docx,txt

# Hugging Face Transformer Model Cache
MODEL_CACHE_DIR=./data/models

# Legal-BERT Encoder Settings
LEGAL_BERT_MODEL=nlpaueb/legal-bert-base-uncased
ENABLE_LEGAL_BERT=True

# SLM (Small Language Model for routine clause summaries)
# Options: mock_local (fast rule-enhanced baseline), hf_local (Hugging Face local), api
SLM_PROVIDER=mock_local
SLM_MODEL_NAME=Qwen/Qwen2.5-3B-Instruct
SLM_DEVICE=cpu

# LLM (Large Language Model for in-depth legal counsel & high-risk clauses)
# Options: mock_local (built-in legal counsel engine), gemini, openai, ollama
LLM_PROVIDER=mock_local
LLM_MODEL_NAME=gemini-2.5-flash
LLM_API_KEY=
LLM_TIMEOUT_SECONDS=30

# Translation Settings
# Supported: English, Tamil, Hindi, Malayalam, Telugu
TRANSLATION_PROVIDER=indic_nllb
DEFAULT_TARGET_LANGUAGE=English
